{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "ShopSphere e-commerce REST API (Node.js, Express, MongoDB, Razorpay)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed_data/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "nodemonConfig": {
    "watch": [
      "src/",
      "app.js",
      "server.js"
    ],
    "ext": "js,json,html",
    "signal": "SIGTERM"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "nodemailer": "^10.6.0",
    "razorpay": "^2.9.8",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
