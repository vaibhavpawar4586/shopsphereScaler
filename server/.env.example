# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3001

# MongoDB connection string (e.g. MongoDB Atlas).
# Leave empty in development to use a local MongoDB that starts automatically.
MONGO_URI=

# Long random string used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend URL(s) allowed by CORS, comma separated (no trailing slash).
CLIENT_URL=http://localhost:5173

# Razorpay test keys from https://dashboard.razorpay.com/app/keys (Test mode).
# Leave empty to use mock payments locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# SendGrid, for the forgot-password OTP email.
# Leave empty in development: the OTP is printed in the server terminal instead.
SENDGRID_API_KEY=
SENDER_EMAIL=

# Passwords for the seeded demo accounts. In development the defaults in src/seed_data/seed.js
# are used when these are empty; in production an account is only created if its password is set.
SEED_ADMIN_PASSWORD=
SEED_SELLER_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Production only: "true" adds the sample catalogue on start-up (development always does).
SEED_SAMPLE_DATA=

# Advanced: cookie SameSite (lax | strict | none) and number of proxies in front of the app.
# Defaults (lax, 1) suit local development; render.yaml sets TRUST_PROXY_HOPS=5 for
# Netlify -> Cloudflare -> Render (check: /api/health "ip" should be your own public IP).
COOKIE_SAMESITE=
TRUST_PROXY_HOPS=
