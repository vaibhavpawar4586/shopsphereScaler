# URL of the backend API (no trailing slash). Normally leave this EMPTY:
# - development: Vite forwards /api to http://localhost:3001
# - production: Netlify forwards /api to Render (see netlify.toml), which keeps the login
#   cookie first-party. Only set it if you host the frontend without that proxy
#   (then also set COOKIE_SAMESITE=none on the API).
VITE_BASE_URL=
